# 复制为 .env 并填写。.env 不要提交、不要发给别人。
# 任何兼容 OpenAI chat/completions 的服务都可以。

# DeepSeek 示例
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 通义千问示例（OpenAI 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 设为 1 时不调用真实模型，返回固定样例，用于联调界面
LLM_MOCK=0

PORT=3000

# ---- 公开部署（如魔搭 Docker 创空间）----
# 本机使用无需设置以下变量。Dockerfile 已设置 ZHISUDA_PUBLIC=1、PORT=7860 和数据目录；
# 域名不要写进镜像或提交到仓库，在平台的环境变量中填写。
# ZHISUDA_PUBLIC=1                        启用公开模式：监听 0.0.0.0，校验写请求来源，限制出网目标和请求频率
# ZHISUDA_ALLOWED_ORIGINS=https://你的创空间域名   可选。精确的 https 来源，逗号分隔，不接受通配符；
#                                         不填时只接受与访问域名同源的写请求（域名取 Host 或 X-Forwarded-Host）
# ZHISUDA_TRUSTED_PROXY_HOPS=1            前面有几层可信反向代理（0—5）；不确定时保持 0，限流将按代理地址合并计数
# ZHISUDA_COOKIE_SAMESITE=None            公开模式默认 None（嵌入页面所需），可改 Lax 或 Strict
# ZHISUDA_RATE_MODEL=12                   每个地址每 10 分钟的模型相关请求数（生成、连接测试、反馈报告）
# ZHISUDA_RATE_UPLOAD=30                  每个地址每 10 分钟的文件上传数
# ZHISUDA_RATE_WRITE=300                  每个地址每 10 分钟的其他写请求数
# 公开模式下不得设置 LLM_API_KEY（共享密钥）；使用者在页面填写自己的 API。
